{
	"name": "@quickemailverification/n8n-nodes-quickemailverification",
	"version": "1.0.2",
	"description": "n8n node for QuickEmailVerification API",
	"keywords": [
		"n8n",
		"n8n-node",
		"n8n-community-node-package",
		"quickemailverification",
		"email",
		"email-verification",
		"email-validation",
		"validation"
	],
	"license": "MIT",
	"homepage": "https://quickemailverification.com",
	"author": {
		"name": "QuickEmailVerification",
		"email": "support@quickemailverification.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/quickemailverification/n8n-nodes-quickemailverification.git"
	},
	"bugs": {
		"url": "https://github.com/quickemailverification/n8n-nodes-quickemailverification/issues"
	},
	"engines": {
		"node": ">=22.22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc && gulp build:assets",
		"dev": "tsc -w",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/QuickEmailVerificationApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/QuickEmailVerification/QuickEmailVerification.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@typescript-eslint/eslint-plugin": "^5.59.8",
		"@typescript-eslint/parser": "^5.59.8",
		"eslint": "^8.41.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.1",
		"eslint-plugin-prettier": "^4.2.1",
		"gulp": "^5.0.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "^2.8.8",
		"typescript": "~5.1.3"
	}
}
